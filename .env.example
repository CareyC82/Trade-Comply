# Copy to .env.local (git-ignored) and fill in secrets.
# Required to expose /api/test-crawl, /api/review/*, /api/debug (local admin or FC).
ADMIN_ROUTES_ENABLED=1
ADMIN_REVIEW_PASSWORD=your-review-password
# Optional dedicated secret for /api/test-crawl; send as X-Admin-Secret or Bearer.
TEST_CRAWL_SECRET=your-test-crawl-secret
DEEPSEEK_API_KEY=sk-your-deepseek-key
# Optional official commodity-level JSON feeds used by the monthly trade-flow job.
JP_OFFICIAL_COMMODITY_FLOW_URL=
SG_OFFICIAL_COMMODITY_FLOW_URL=
# Optional official exact tariff-line JSON feeds.
EU_TARIC_EXACT_LINES_URL=
CN_CUSTOMS_EXACT_TARIFF_URL=
SG_AHTN_EXACT_TARIFF_URL=
MX_TIGIE_NICO_EXACT_TARIFF_URL=
