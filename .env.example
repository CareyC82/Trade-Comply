# Copy to .env.local (git-ignored) and fill in secrets.
# Required to expose /api/test-crawl, /api/review/*, /api/debug (local admin or FC).
ADMIN_ROUTES_ENABLED=1
ADMIN_REVIEW_PASSWORD=your-review-password
# Optional dedicated secret for /api/test-crawl; send as X-Admin-Secret or Bearer.
TEST_CRAWL_SECRET=your-test-crawl-secret
DEEPSEEK_API_KEY=sk-your-deepseek-key
# Optional official commodity-level JSON feeds used by the monthly trade-flow job.
JP_OFFICIAL_COMMODITY_FLOW_URL=
SG_OFFICIAL_COMMODITY_FLOW_URL=
# Optional official exact tariff-line JSON feeds.
EU_TARIC_EXACT_LINES_URL=
CN_CUSTOMS_EXACT_TARIFF_URL=
SG_AHTN_EXACT_TARIFF_URL=
MX_TIGIE_NICO_EXACT_TARIFF_URL=

# Consumer server (npm run dev:consumer)
CONSUMER_PORT=8790
CONSUMER_HOST=127.0.0.1
CONSUMER_PUBLIC_URL=https://your-consumer-domain.example
CONSUMER_DATA_DIR=.runtime/consumer
# Production: generate separate random values (at least 32 bytes each).
CONSUMER_SESSION_SECRET=
CONSUMER_FILE_ENCRYPTION_KEY=
CONSUMER_FILE_RETENTION_DAYS=30
CONSUMER_DISK_WARNING_PERCENT=85
CONSUMER_SHUTDOWN_TIMEOUT_MS=10000
# Optional override. Default is the official FCC OET Laboratory API.
FCC_EAS_API_URL=https://apps.fcc.gov/OETLabServices/getFCCIDList
FCC_EAS_CACHE_SECONDS=21600
# Known official test record used only by the operations probe.
FCC_EAS_PROBE_ID=OPS10
# Server-side only. Never expose this key in browser JavaScript.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional parser binary overrides.
PDFTOTEXT_BIN=pdftotext
TESSERACT_BIN=tesseract
OCR_LANG=eng
